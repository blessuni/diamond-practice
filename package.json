{
  "name": "jinju-maeum-gems",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs && node --import tsx --test tests/*.test.tsx",
    "deploy": "netlify deploy --prod --dir=dist --functions=netlify/functions",
    "bundle-functions": "netlify functions:build --src netlify/functions --functions deploy-functions",
    "deploy:ready": "netlify deploy --prod --no-build --dir=dist --functions=deploy-functions"
  },
  "dependencies": {
    "@netlify/blobs": "11.1.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@netlify/vite-plugin": "^3.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitejs/plugin-react": "6.0.2",
    "jsdom": "^30.1.1",
    "netlify-cli": "^23.0.0",
    "tsx": "^4.23.15",
    "vite": "8.0.13"
  }
}
